{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `data` holds the authored dictionary sources. They are build inputs for
  // scripts/gen-dictionary.mjs, never imported by the app, but they are
  // typechecked here so a malformed entry is caught while editing.
  "include": ["src", "data"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
